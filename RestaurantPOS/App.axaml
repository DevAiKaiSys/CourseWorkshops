<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RestaurantPOS.App"
             xmlns:local="using:RestaurantPOS"
             xmlns:converters="clr-namespace:RestaurantPOS.Converters"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://RestaurantPOS/Resources/Styles/Colors.axaml" />
        <StyleInclude Source="avares://RestaurantPOS/Icons.axaml" />
    </Application.Styles>

    <Application.Resources>
        <converters:IconPathConverter x:Key="IconPathConverter" />
        <converters:BooleanToForegroundConverter x:Key="BooleanToForegroundConverter" />
    </Application.Resources>
</Application>