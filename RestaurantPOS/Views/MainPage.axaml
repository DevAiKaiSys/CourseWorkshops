<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RestaurantPOS.ViewModels"
             xmlns:models="clr-namespace:RestaurantPOS.Models"
             xmlns:converters="clr-namespace:RestaurantPOS.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="RestaurantPOS.Views.MainPage"
             x:DataType="vm:MainPageViewModel">
    <UserControl.Resources>
        <!-- Register the converter here -->
        <converters:CategorySelectedToBrushConverter x:Key="CategorySelectedToBrushConverter" />
    </UserControl.Resources>

    <Grid ColumnDefinitions=".75*, .25*">
        <Grid Grid.Column="0"
              RowDefinitions="Auto, Auto, *"
              Margin="15">
            <Label Grid.Row="0"
                   Margin="0,10">
                Hello, AiKaiSys
            </Label>
            <!-- <Label Grid.Row="1">Categories List</Label> -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,10"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}"
                              Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MenuCategoryModel">
                            <!--<Border Padding="20, 10"
                                    Background="{StaticResource LightWheat}"
                                    CornerRadius="10"
                                    BorderThickness="0"
                                    Margin="10,0">-->
                            <Border Padding="20, 10"
                                    Background="{Binding IsSelected, Converter={StaticResource CategorySelectedToBrushConverter}}"
                                    CornerRadius="10"
                                    BorderThickness="0"
                                    Margin="10,0">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5">
                                    <Image Height="20"
                                           Width="20"
                                           Source="{Binding Icon, Converter={StaticResource IconPathConverter}}" />
                                    <Label Content="{Binding Name}"
                                           Foreground="Maroon" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Label Grid.Row="2"
                   Margin="0,10">
                Menu Items List
            </Label>
        </Grid>
        <Grid Grid.Column="1"
              Background="{StaticResource LightWheat}">
            <Label>Current Order Items</Label>
        </Grid>
    </Grid>
</UserControl>