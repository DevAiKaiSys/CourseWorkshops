<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="RestaurantPOS.Views.MainPage">
    <Grid ColumnDefinitions=".75*, .25*">
        <Grid Grid.Column="0"
              RowDefinitions="Auto, Auto, *"
              Margin="15">
            <Label Grid.Row="0">Hello, AiKaiSys</Label>
            <Label Grid.Row="1">Categories List</Label>
            <Label Grid.Row="2">Menu Items List</Label>
        </Grid>
        <Grid Grid.Column="1"
              Background="{StaticResource LightWheat}">
            <Label>Current Order Items</Label>
        </Grid>
    </Grid>
</UserControl>