<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantPOS.ViewModels"
             xmlns:models="clr-namespace:RestaurantPOS.Models"
             xmlns:data="clr-namespace:RestaurantPOS.Data"
             xmlns:controls="clr-namespace:RestaurantPOS.Controls"
             x:Class="RestaurantPOS.Controls.CategoriesListControl"
             x:Name="this">
  
    <CollectionView Grid.Row="1"
                    BindingContext="{x:Reference this}"
                    ItemsSource="{Binding Categories}">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal"
                               ItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:MenuCategoryModel">
                <Border Padding="20, 10"
                        BackgroundColor="{StaticResource LightWheat}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                    <HorizontalStackLayout Spacing="5">
                        <Image Source="{Binding Icon}"
                               HeightRequest="20"
                               WidthRequest="20"
                               VerticalOptions="Center" />
                        <Label Text="{Binding Name}"
                               VerticalOptions="Center"
                               TextColor="Maroon">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}"
                                             TargetType="Label"
                                             Value="True">
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}"
                                     TargetType="Border"
                                     Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="Maroon" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type controls:CategoriesListControl}}, Path=SelectCategoryCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentView>
